{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["react", "react-dom"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["ui.tsx", "ui/**/*.ts", "ui/**/*.tsx", "types.mts"]
}
